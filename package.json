{
  "name": "fixbook-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/utils/seed.js",
    "test:unit": "node --require ./tests/setup/env.js --test --test-reporter=spec \"tests/unit/**/*.test.js\"",
    "test:integration": "node --require ./tests/setup/env.js --test --test-concurrency=1 --test-timeout=30000 --test-reporter=spec \"tests/integration/**/*.test.js\"",
    "test": "mkdir -p coverage && node --require ./tests/setup/env.js --test --test-concurrency=1 --test-timeout=30000 --experimental-test-coverage --test-coverage-include=app.js --test-coverage-include=\"src/**/*.js\" --test-coverage-exclude=src/utils/seed.js --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"tests/unit/**/*.test.js\" \"tests/integration/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-microsoft": "^2.0.0"
  },
  "devDependencies": {
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "nodemon": "^3.1.4",
    "semantic-release": "^25.0.9",
    "supertest": "^7.3.2"
  },
  "overrides": {
    "@semantic-release/npm": {
      "npm": "npm:empty-npm-package@1.0.0"
    }
  }
}
